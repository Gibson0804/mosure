    "kb_global_create_doc": {
        "name": "kb_global_create_doc",
        "description": "在知识库中新建文档。秘书使用；可用 categoryId 或 categoryPath 指定目录，未指定则创建到“默认”目录。",
        "params": {
            "title": {
                "type": "string",
                "required": true,
                "desc": "文档标题"
            },
            "content": {
                "type": "string",
                "required": false,
                "desc": "Markdown正文"
            },
            "summary": {
                "type": "string",
                "required": false,
                "desc": "摘要"
            },
            "tags": {
                "type": "array",
                "required": false,
                "desc": "标签数组"
            },
            "status": {
                "type": "string",
                "required": false,
                "desc": "private 或 public，默认 private"
            },
            "categoryId": {
                "type": "integer",
                "required": false,
                "desc": "目标目录ID，不传则使用“默认”目录"
            },
            "categoryPath": {
                "type": "string",
                "required": false,
                "desc": "目标目录路径，如 \/电子商务；categoryId 优先"
            }
