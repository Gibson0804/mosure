            "updatedContent": {
                "type": "string",
                "required": false,
                "desc": "修改后的完整 Markdown 正文；适合复杂改写"
            },
            "appendContent": {
                "type": "string",
                "required": false,
                "desc": "要追加到文档末尾的内容"
