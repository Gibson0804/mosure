            "filters": {
                "type": "object",
                "required": false,
                "desc": "筛选条件：keyword、enabled(true\/false)"
            }
        },
        "service": "App\\Services\\CloudCronService",
        "method": "list"
    },
    "cron_detail": {
        "name": "cron_detail",
        "description": "查询定时任务详情：根据ID获取定时任务完整信息。",
        "params": {
            "id": {
                "type": "integer",
                "required": true,
                "desc": "定时任务ID"
            }
        },
        "service": "App\\Services\\CloudCronService",
